# ───────────────────────────────────────────────────────────────────────────
# FRONTEND env (guest-app) — the standalone guest-only PWA.
# NOTE: the deployed product is admin-portal (the unified Admin/Driver/Guest
# app). Only set these if you separately deploy guest-app.
#
# Vite inlines these at BUILD time — redeploy after changing any value.
# ───────────────────────────────────────────────────────────────────────────

# REQUIRED — base URL of the backend (REST API + Socket.IO). NO trailing slash.
VITE_API_URL="https://smart-cab-backend.onrender.com"

# Payments (optional; required for the guest "Pay now" / Stripe Elements UI).
# Publishable key is public/safe. Use the TEST key (pk_test_...). Redeploy after setting.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
