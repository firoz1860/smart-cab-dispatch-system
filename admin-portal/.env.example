# ───────────────────────────────────────────────────────────────────────────
# FRONTEND env (Vercel project: admin-portal, served at scds-admin.vercel.app)
# This is the single unified Admin / Driver / Guest web app.
#
# IMPORTANT: Vite inlines these at BUILD time. After changing ANY value in
# Vercel you MUST redeploy the project for it to take effect.
# Local dev: copy to admin-portal/.env (or .env.local).
# ───────────────────────────────────────────────────────────────────────────

# REQUIRED — base URL of the backend (REST API + Socket.IO). NO trailing slash.
VITE_API_URL="https://smart-cab-backend.onrender.com"

# Payments (optional; required for the guest "Pay now" / Stripe Elements UI).
# Publishable keys are public and safe to expose in the client bundle.
# Use the TEST key (pk_test_...). Remember to REDEPLOY after setting it, or the
# payment form stays disabled.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
