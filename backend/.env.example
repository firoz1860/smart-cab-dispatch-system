# ───────────────────────────────────────────────────────────────────────────
# BACKEND env (Render service: smart-cab-backend)
# Copy to backend/.env for local dev; set these in Render's dashboard in prod.
# Never commit the real .env (it's gitignored).
# ───────────────────────────────────────────────────────────────────────────

# REQUIRED — Prisma SQLite database path.
# Local dev: a file in the backend dir. NOTE: on Render's free tier the
# filesystem is EPHEMERAL (wiped on redeploy / spin-down), so data resets;
# attach a Render Disk or move to Postgres to persist.
DATABASE_URL="file:./dev.db"

# REQUIRED — signs & verifies the session JWT (httpOnly cookie + Socket.IO
# handshake). If missing, auth throws. Generate: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# REQUIRED IN PRODUCTION — must be exactly "production" on Render so the auth
# cookie is set SameSite=None; Secure (required for cross-site Vercel<->Render).
# If not "production", the cookie is SameSite=Lax and cross-domain login
# silently breaks (login succeeds, every later request looks logged-out).
# Local dev: leave as "development".
NODE_ENV="development"

# REQUIRED IN PRODUCTION — exact frontend origin(s) allowed for credentialed
# CORS, comma-separated. Match scheme+host EXACTLY, NO trailing slash.
# Any localhost:* is always allowed, so this is only needed for deployments.
CORS_ORIGIN="https://scds-admin.vercel.app"

# Server port. Render injects PORT automatically — do NOT set it on Render.
# Local dev falls back to 4000 if unset.
# PORT=4000

# ── Payments (optional; required only to actually charge fares) ────────────
# Use TEST-mode keys. Without these, fares are still computed & shown but
# nothing can be charged.
# STRIPE_SECRET_KEY must be a VALID secret key, i.e. starts with sk_test_
# (a common mistake is pasting the pk_ publishable or whsec_ webhook value here).
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Signing secret of the Stripe webhook ENDPOINT that points at THIS backend's
#   https://smart-cab-backend.onrender.com/webhooks/stripe
# (Stripe Dashboard -> Developers -> Webhooks -> that endpoint -> Signing secret).
# It is specific to that one endpoint and is NOT the secret key above.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── UPI QR payments via Razorpay (optional; required to accept UPI QR) ─────
# Server-side ONLY - none of these are ever sent to the browser. Without them,
# the "Pay via QR" option reports "not configured" and guests use Stripe.
# From Razorpay Dashboard (TEST mode) -> Settings -> API Keys:
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# From Razorpay Dashboard -> Settings -> Webhooks: the secret you set when
# creating the webhook that points at THIS backend's /webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Routing / ETAs (optional) ─────────────────────────────────────────────
# If set, uses Google Distance Matrix for real road distance & ETAs.
# If unset, the app falls back to a straight-line (Haversine) estimate and
# works fine — this is purely an accuracy upgrade.
# GOOGLE_MAPS_API_KEY="AIza..."
